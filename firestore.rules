rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reviews: Public read and write so all customers can submit and view reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.comment is string;
      allow update, delete: if true;
    }

    // Orders: Public create for customers, read and update for order tracking
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Enquiries: Public create and read
    match /enquiries/{enquiryId} {
      allow read, create, update: if true;
      allow delete: if true;
    }
  }
}
